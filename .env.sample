# Copy this file to .env and fill in your values

# =============================================================================
# Sample Agent Configuration
# =============================================================================
# Your Azure OpenAI endpoint URL (e.g., https://your-resource.openai.azure.com/)
AZURE_OPENAI_ENDPOINT=

# Your Azure OpenAI API key
AZURE_OPENAI_API_KEY=

# The deployment name for your model (e.g., gpt-5.2-chat)
AZURE_OPENAI_DEPLOYMENT=

# Optional API version (e.g., 2024-12-01-preview)
OPENAI_API_VERSION=

# =============================================================================
# Logging Configuration
# =============================================================================
# Log level for all sample apps (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO