# Copy this file to .env and fill in your values

# =============================================================================
# Sample Agent Configuration
# =============================================================================
# Your Azure OpenAI endpoint URL (e.g., https://your-resource.openai.azure.com/)
AZURE_OPENAI_ENDPOINT=

# Your Azure OpenAI API key
AZURE_OPENAI_API_KEY=

# The deployment name for your model (e.g., gpt-5.2-chat)
AZURE_OPENAI_DEPLOYMENT=

# API version
OPENAI_API_VERSION=

# =============================================================================
# Logging Configuration
# =============================================================================
# Log level for the sample API (DEBUG, INFO, WARNING, ERROR, CRITICAL)
SAMPLE_API_LOG_LEVEL=INFO

# Log level for the sample agent (DEBUG, INFO, WARNING, ERROR, CRITICAL)
SAMPLE_AGENT_LOG_LEVEL=INFO