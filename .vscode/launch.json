{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Sample API",
            "type": "debugpy",
            "request": "launch",
            "module": "uvicorn",
            "args": [
                "sample_api.main:app",
                "--reload",
                "--port",
                "3001",
                "--env-file",
                "${workspaceFolder}/.env"
            ],
            "python": "${workspaceFolder}/.venv/bin/python",
            "cwd": "${workspaceFolder}/samples/api/src",
            "console": "integratedTerminal",
            "internalConsoleOptions": "neverOpen"
        },
        {
            "name": "Agent Framework",
            "type": "debugpy",
            "request": "launch",
            "module": "sample_agent_framework.main",
            "python": "${workspaceFolder}/.venv/bin/python",
            "cwd": "${workspaceFolder}/samples/agent-framework/src",
            "console": "integratedTerminal",
            "internalConsoleOptions": "neverOpen",
            "envFile": "${workspaceFolder}/.env",
            "preLaunchTask": "Wait for API"
        }
    ],
    "compounds": [
        {
            "name": "Sample API + Agent Framework",
            "configurations": ["Sample API", "Agent Framework"],
            "stopAll": true
        }
    ]
}